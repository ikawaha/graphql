[
  {"name": "a scalar field", "sdl": "type Query { a: String }", "query": "{ a }", "root": {"a": "x"}},
  {"name": "a field that is absent from the root", "sdl": "type Query { a: String }", "query": "{ a }", "root": {}},
  {"name": "a field given null", "sdl": "type Query { a: String }", "query": "{ a }", "root": {"a": null}},
  {"name": "a non-null field given null", "sdl": "type Query { a: String! }", "query": "{ a }", "root": {"a": null}},
  {"name": "a non-null field inside a nullable one", "sdl": "type Query { o: O } type O { a: String! }", "query": "{ o { a } }", "root": {"o": {"a": null}}},
  {"name": "a non-null chain to the root", "sdl": "type Query { o: O! } type O { a: String! }", "query": "{ o { a } }", "root": {"o": {"a": null}}},
  {"name": "an alias", "sdl": "type Query { a: String }", "query": "{ x: a }", "root": {"a": "v"}},
  {"name": "the same field twice", "sdl": "type Query { a: String }", "query": "{ a a }", "root": {"a": "v"}},
  {"name": "typename", "sdl": "type Query { a: String }", "query": "{ __typename a }", "root": {"a": "v"}},
  {"name": "a list", "sdl": "type Query { l: [Int] }", "query": "{ l }", "root": {"l": [1, 2, 3]}},
  {"name": "a list holding null", "sdl": "type Query { l: [Int] }", "query": "{ l }", "root": {"l": [1, null, 3]}},
  {"name": "a list of non-null holding null", "sdl": "type Query { l: [Int!] }", "query": "{ l }", "root": {"l": [1, null, 3]}},
  {"name": "a list that is null", "sdl": "type Query { l: [Int] }", "query": "{ l }", "root": {"l": null}},
  {"name": "a nested list", "sdl": "type Query { l: [[Int]] }", "query": "{ l }", "root": {"l": [[1], [2, null]]}},
  {"name": "a value that is not a list", "sdl": "type Query { l: [Int] }", "query": "{ l }", "root": {"l": 1}},
  {"name": "an enum", "sdl": "type Query { e: E } enum E { A B }", "query": "{ e }", "root": {"e": "A"}},
  {"name": "an enum value the schema lacks", "sdl": "type Query { e: E } enum E { A B }", "query": "{ e }", "root": {"e": "Z"}},
  {"name": "Int too large", "sdl": "type Query { n: Int }", "query": "{ n }", "root": {"n": 9007199254740991}},
  {"name": "Int from a float", "sdl": "type Query { n: Int }", "query": "{ n }", "root": {"n": 1.5}},
  {"name": "Float from an int", "sdl": "type Query { f: Float }", "query": "{ f }", "root": {"f": 1}},
  {"name": "ID from an int", "sdl": "type Query { i: ID }", "query": "{ i }", "root": {"i": 1}},
  {"name": "Boolean from a string", "sdl": "type Query { b: Boolean }", "query": "{ b }", "root": {"b": "yes"}},
  {"name": "String from a number", "sdl": "type Query { s: String }", "query": "{ s }", "root": {"s": 1}},
  {"name": "an argument with a default", "sdl": "type Query { a(x: Int = 7): Int }", "query": "{ a }", "root": {"a": 0}},
  {"name": "skip and include", "sdl": "type Query { a: String b: String }", "query": "{ a @skip(if: true) b @include(if: false) }", "root": {"a": "1", "b": "2"}},
  {"name": "a fragment", "sdl": "type Query { a: String }", "query": "{ ...F } fragment F on Query { a }", "root": {"a": "v"}},
  {"name": "an inline fragment on the wrong type", "sdl": "type Query { a: String }", "query": "{ ... on Query { a } }", "root": {"a": "v"}},
  {"name": "a variable", "sdl": "type Query { a(x: Int): Int }", "query": "query ($x: Int) { a(x: $x) }", "variables": {"x": 3}, "root": {"a": 1}},
  {"name": "a variable given null", "sdl": "type Query { a(x: Int): Int }", "query": "query ($x: Int) { a(x: $x) }", "variables": {"x": null}, "root": {"a": 1}},
  {"name": "a variable not supplied", "sdl": "type Query { a(x: Int): Int }", "query": "query ($x: Int) { a(x: $x) }", "root": {"a": 1}},
  {"name": "a non-null variable not supplied", "sdl": "type Query { a(x: Int!): Int }", "query": "query ($x: Int!) { a(x: $x) }", "root": {"a": 1}},
  {"name": "a variable of the wrong type", "sdl": "type Query { a(x: Int): Int }", "query": "query ($x: Int) { a(x: $x) }", "variables": {"x": "no"}, "root": {"a": 1}},
  {"name": "an input object variable", "sdl": "type Query { a(i: In): Int } input In { x: Int y: Int = 5 }", "query": "query ($i: In) { a(i: $i) }", "variables": {"i": {"x": 1}}, "root": {"a": 1}},
  {"name": "an input object missing a required field", "sdl": "type Query { a(i: In): Int } input In { x: Int! }", "query": "query ($i: In) { a(i: $i) }", "variables": {"i": {}}, "root": {"a": 1}},
  {"name": "an unknown operation name", "sdl": "type Query { a: String }", "query": "query Q { a }", "operationName": "Nope", "root": {"a": "v"}},
  {"name": "no operation at all", "sdl": "type Query { a: String }", "query": "fragment F on Query { a }", "root": {"a": "v"}},
  {"name": "two operations with no name given", "sdl": "type Query { a: String }", "query": "query A { a } query B { a }", "root": {"a": "v"}},
  {"name": "an interface resolved by __typename", "sdl": "type Query { i: I } interface I { a: String } type T implements I { a: String }", "query": "{ i { a __typename } }", "root": {"i": {"__typename": "T", "a": "v"}}},
  {"name": "an interface that cannot be resolved", "sdl": "type Query { i: I } interface I { a: String } type T implements I { a: String }", "query": "{ i { a } }", "root": {"i": {"a": "v"}}},
  {"name": "a union resolved by __typename", "sdl": "type Query { u: U } union U = T type T { a: String }", "query": "{ u { ... on T { a } } }", "root": {"u": {"__typename": "T", "a": "v"}}},
  {"name": "deeply nested objects", "sdl": "type Query { o: O } type O { o: O a: String }", "query": "{ o { o { o { a } } } }", "root": {"o": {"o": {"o": {"a": "deep"}}}}},
  {"name": "a mutation runs in order", "sdl": "type Query { a: String } type Mutation { x: String y: String }", "query": "mutation { x y }", "root": {"x": "1", "y": "2"}}
]
